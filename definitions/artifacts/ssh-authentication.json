{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$md": {
    "name": "ssh-authentication"
  },
  "type": "object",
  "title": "SSH Authentication",
  "description": "SSH public/private keypair with contextual user and hostname",
  "required": [
    "user",
    "hostname",
    "private_key",
    "public_key"
  ],
  "properties": {
    "user": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "private_key": {
      "type": "string",
      "$md.sensitive": true
    },
    "public_key": {
      "type": "string"
    },
    "specs": {
      "type": "object",
      "properties": {
        "aws": {
          "$ref": "../specs/aws.json"
        },
        "cryptography": {
          "$ref": "../specs/cryptography.json"
        }
      }
    }
  }
}
