{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$md": {
    "name": "draft-node"
  },
  "type": "object",
  "title": "Draft Node",
  "description": "A resource that can be used to visually design architecture without provisioning real infrastructure.",
  "required": [
    "name",
    "specs"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "name",
      "description": "Name",
      "examples": [
        "Network",
        "Cluster",
        "Function",
        "Queue"
      ]
    },
    "specs": {
      "type": "object",
      "required": [],
      "properties": {}
    }
  }
}
